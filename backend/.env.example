# Google AI Studio API key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-api-key-here

# Gemini model for text generation
GEMINI_MODEL=gemini-3.0-flash

# Speech-to-Text via Groq Whisper (get key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
STT_MODEL=whisper-large-v3-turbo
# Models: whisper-large-v3-turbo (fastest), whisper-large-v3 (highest quality)

# Text-to-Speech via Edge TTS (Microsoft Neural voices — fast, free, no rate limits)
TTS_ENABLED=true
TTS_VOICE=en-US-AriaNeural
# Voices: en-US-AriaNeural (default), en-US-JennyNeural, en-US-GuyNeural,
#          en-GB-SoniaNeural, en-AU-NatashaNeural (see edge-tts --list-voices)
